{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Test",
      "type": "shell",
      "command": "pnpm",
      "args": [
        "run",
        "check:full"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [],
      "group": {
        "kind": "test",
        "isDefault": true
      }
    },
    {
      "label": "Core tests",
      "type": "shell",
      "command": "pnpm",
      "args": [
        "run",
        "check:core"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    },
    {
      "label": "Validate docs",
      "type": "shell",
      "command": "pnpm",
      "args": [
        "run",
        "validate"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    },
    {
      "label": "Benchmark",
      "type": "shell",
      "command": "python",
      "args": [
        "SKILLS/pixel-art-html/scripts/benchmark_small_grids.py",
        "--output",
        ".scratch/small-grid-benchmark"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    },
    {
      "label": "Diff",
      "type": "shell",
      "command": "git",
      "args": [
        "diff",
        "--check"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    }
  ]
}
